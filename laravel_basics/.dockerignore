# Environment files and secrets
.env
.env.*
!.env.example
!.env.docker.example

# Version control
.git
.gitignore

# Application dependencies (built in multi-stage Docker build)
node_modules
vendor

# Logs, test outputs, and cache
storage/logs/*
!storage/logs/.gitignore
bootstrap/cache/*.php
!bootstrap/cache/.gitignore
.phpunit.result.cache
coverage

# SQLite runtime databases (avoid baking local dev databases into image)
database/*.sqlite
database/*.sqlite-journal

# IDE and OS files
.idea
.vscode
.DS_Store
Thumbs.db

# Test suites and development hot files (production image optimization)
tests
public/hot
npm-debug.log*
yarn-error.log*
