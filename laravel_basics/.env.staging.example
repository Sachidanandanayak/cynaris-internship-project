# ==============================================================================
# Cynaris Internship Portal — Staging Environment Configuration Template
# Target: Staging / Pre-Production Validation Runtime
# Application: laravel_basics (Laravel 13.x, PHP 8.4)
# ==============================================================================
# INSTRUCTIONS FOR STAGING DEPLOYMENT:
# 1. Copy this template to .env on your staging server or staging container:
#      cp .env.staging.example .env
# 2. Generate a secure application key:
#      php artisan key:generate
# 3. Configure valid staging database credentials and external service API keys.
# 4. Run database migrations in forced production/staging mode:
#      php artisan migrate --force
# 5. Optimize configuration, routes, and views for production parity:
#      php artisan config:cache
#      php artisan route:cache
#      php artisan view:cache
# 6. SECURITY MANDATE: NEVER commit real production or staging secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings (Production Parity)
# ------------------------------------------------------------------------------
APP_NAME="Cynaris Internship Portal (Staging)"
APP_ENV=staging
APP_KEY=base64:REPLACE_WITH_STAGING_KEY_64_CHARACTER_BASE64=
APP_DEBUG=false
APP_URL=https://staging.cynaris.local

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode
APP_MAINTENANCE_DRIVER=file

# Security: Password Hashing Cost
BCRYPT_ROUNDS=12

# Debugbar is strictly disabled in staging
DEBUGBAR_ENABLED=false

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Default: SQLite for isolated lightweight staging validation
DB_CONNECTION=sqlite
# For Staging with PostgreSQL / MySQL, uncomment and configure:
# DB_CONNECTION=pgsql
# DB_HOST=postgres-staging
# DB_PORT=5432
# DB_DATABASE=cynaris_staging
# DB_USERNAME=cynaris_staging_user
# DB_PASSWORD=staging_secure_password_replace_me

# ------------------------------------------------------------------------------
# Session & State Management
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ------------------------------------------------------------------------------
# Cache & Queue Configuration
# ------------------------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=cynaris_staging_cache

QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Mail Configuration (Staging Log / Mock Mailer)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="staging-alerts@cynaris.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Filesystem Configuration
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# AI Provider Gateway: Tier 1 (Groq API)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_staging_replace_with_valid_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT=10

# ------------------------------------------------------------------------------
# AI Provider Gateway: Tier 2 Fallback (OpenRouter API)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-staging_replace_with_valid_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT=15

# ------------------------------------------------------------------------------
# CIA Career Intelligence: Structured Logging & Zero-Trust Redaction
# ------------------------------------------------------------------------------
CIA_LOGGING_ENABLED=true
CIA_LOG_CHANNEL=single
CIA_LOG_REDACT_PII=true
CIA_LOG_MAX_PAYLOAD=300

# ------------------------------------------------------------------------------
# CIA Career Intelligence: Telemetry & Latency Monitoring
# ------------------------------------------------------------------------------
CIA_MONITORING_ENABLED=true
CIA_METRICS_WINDOW_MINUTES=60

# ------------------------------------------------------------------------------
# CIA Career Intelligence: Health Thresholds & Alerting
# ------------------------------------------------------------------------------
CIA_ALERTING_ENABLED=true
CIA_ALERT_CHANNEL=single
CIA_ALERT_THROTTLE_SECONDS=300
CIA_ALERT_AI_FAILURES_THRESHOLD=3
CIA_ALERT_CHROMA_FAILURES_THRESHOLD=3
CIA_ALERT_ERROR_RATE_THRESHOLD=25.0
CIA_ALERT_LATENCY_P95_THRESHOLD=5000.0
CIA_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/STAGING/WEBHOOK/ALERT

# ------------------------------------------------------------------------------
# Frontend Asset Pipeline (Vite)
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
