# ==============================================================================
# Cynaris Internship — Docker Local Development Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env.docker:
#    cp .env.docker.example .env.docker
# 2. Update with your local Docker development preferences.
# 3. SECURITY RULE: Never commit real APP_KEY, production credentials, or secrets.
# ==============================================================================

APP_NAME="Cynaris Job Board (Docker)"
APP_ENV=local
APP_KEY=base64:EXAMPLE_DEV_KEY_REPLACE_WITH_YOUR_LOCAL_KEY_1234=
APP_DEBUG=true
APP_URL=http://localhost:8000
DEBUGBAR_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Containerized PostgreSQL Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cynaris_db
DB_USERNAME=cynaris_user
DB_PASSWORD=cynaris_secret

# Host Exposed Port Mapping
APP_PORT=8000
DB_PORT=5432

# State Management via PostgreSQL Tables
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
FILESYSTEM_DISK=local
